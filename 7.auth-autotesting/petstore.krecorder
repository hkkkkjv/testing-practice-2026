<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
<title>petstore</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">auth</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://petstore.octoperf.com/<datalist><option>https://petstore.octoperf.com/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>link=Enter the Store<datalist><option>link=Enter the Store</option><option>xpath=//a[contains(text(),'Enter the Store')]</option><option>xpath=//div[@id='Content']/p/a</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Welcome to JPetStore 6'])[1]/following::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Copyright www.mybatis.org'])[1]/preceding::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Katalon Recorder is recording ...'])[1]/preceding::a[1]</option><option>xpath=//*/text()[normalize-space(.)='Enter the Store']/parent::*</option><option>xpath=//a[contains(@href, 'actions/Catalog.action')]</option><option>xpath=//a</option><option>css=a</option></datalist></td><td></td></tr>
<tr><td>click</td><td>link=Sign In<datalist><option>link=Sign In</option><option>xpath=//a[contains(text(),'Sign In')]</option><option>xpath=//div[@id='MenuContent']/a[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='?'])[1]/preceding::a[1]</option><option>xpath=//*/text()[normalize-space(.)='Sign In']/parent::*</option><option>xpath=//a[contains(@href, '/actions/Account.action?signonForm=')]</option><option>xpath=//a[2]</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=stripes-2091140461<datalist><option>id=stripes-2091140461</option><option>name=username</option><option>xpath=//input[@id='stripes-2091140461']</option><option>xpath=//div[@id='Catalog']/form/p[2]/input</option><option>xpath=//p[2]/input</option><option>css=#stripes-2091140461</option></datalist></td><td>hkkkkjv</td></tr>
<tr><td>click</td><td>name=password<datalist><option>name=password</option><option>xpath=//input[@name='password']</option><option>xpath=//div[@id='Catalog']/form/p[2]/input[2]</option><option>xpath=//p[2]/input[2]</option><option>css=input[name="password"]</option></datalist></td><td></td></tr>
<tr><td>type</td><td>name=password<datalist><option>name=password</option><option>xpath=//input[@name='password']</option><option>xpath=//div[@id='Catalog']/form/p[2]/input[2]</option><option>xpath=//p[2]/input[2]</option><option>css=input[name="password"]</option></datalist></td><td>hkkkkjv26</td></tr>
<tr><td>click</td><td>name=signon<datalist><option>name=signon</option><option>xpath=//input[@name='signon']</option><option>xpath=//div[@id='Catalog']/form/input</option><option>xpath=//div[2]/div/form/input</option><option>css=input[name="signon"]</option></datalist></td><td></td></tr>
</tbody></table>
</body>
</html>